# Vorlage: als ".env" kopieren und ausfüllen. Die .env wird NICHT auf GitHub hochgeladen.

ADMIN_PASSWORD=bitte-aendern

# --- E-Mail-Versand (Beispiel Gmail) ---
# Gmail braucht ein App-Passwort (nicht das normale Passwort):
# Google-Konto -> Sicherheit -> 2-Faktor-Authentifizierung aktivieren -> "App-Passwörter"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine.adresse@gmail.com
SMTP_PASSWORD=
# MAIL_FROM=deine.adresse@gmail.com
# Empfänger, mehrere mit Komma getrennt
MAIL_TO=empfaenger@example.com

# Adresse der Website für die Links in der Mail
SITE_URL=http://127.0.0.1:8000
