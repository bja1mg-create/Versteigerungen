{
  "name": "edikt-immo",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postStartCommand": "nohup bash -c 'ADMIN_PASSWORD=${ADMIN_PASSWORD:-test123} python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/uvicorn.log 2>&1 &'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Website", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
